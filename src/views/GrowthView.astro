  document.addEventListener("visibilitychange", () => { if (document.visibilityState === "visible") { /* daily refresh of age/milestone states */ render(); kick(); } });
  // refresh at local midnight so "this week / now" and age bands never go stale overnight
  (function scheduleMidnight() {
    const now = new Date();
    const next = new Date(now.getFullYear(), now.getMonth(), now.getDate() + 1, 0, 0, 5);
    setTimeout(() => { calYM = null; render(); kick(); scheduleMidnight(); }, Math.max(1000, next - now));
  })();

  render();
  photoList().then((l) => { photos = l; render(); kick(); }).catch(() => kick());
</script>

