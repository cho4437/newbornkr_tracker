---
import { APP_NAME, lp } from "../lib/site";
// 성장 캘린더 & 타임라인 + 성장 사진 (birth date and photos on this device; shared via the tracker's family code when connected).
import Base from "../layouts/Base.astro";
import { SOURCES } from "../lib/growth-data.js";
interface Props { lang: "ko" | "en" | "pt" }
const { lang } = Astro.props;
const en = lang !== "ko"; // en + pt
const t3 = (ko: string, e: string, pt: string) => (lang === "pt" ? pt : lang === "en" ? e : ko);
const M_PT = { title: "Calendário de crescimento | marcos, vacinas e consultas do bebê", desc: "Informe a data de nascimento do bebê para ver marcos do desenvolvimento, as datas de vacinas e consultas na Coreia e guardar fotos de crescimento.",
      h1: "Calendário e linha do tempo do crescimento", sub: "Marcos do desenvolvimento, vacinas do calendário nacional coreano e consultas infantis por idade, com datas calculadas a partir do nascimento do bebê.",
      birthQ: "Data de nascimento do bebê", save: "Salvar", change: "Alterar data de nascimento", setupNote: "Fica guardado neste aparelho (navegador). Com um código da família, a data de nascimento e as fotos são compartilhadas com a família.",
      tabTl: "Linha do tempo", tabPh: "Fotos", upTitle: "Próximos itens", addPh: "Adicionar fotos", exportPh: "Baixar tudo (ZIP)",
      disc: "Cada criança se desenvolve no seu ritmo. Os marcos são do CDC dos EUA (o que a maioria das crianças, 75% ou mais, faz até essa idade) e não são uma ferramenta de triagem. Se seu filho perder habilidades que já tinha ou algo preocupar, fale com um pediatra. As datas de vacinas e consultas são as recomendadas a partir do nascimento; confirme o calendário real com a clínica ou no KDCA Immunization Helper (nip.kdca.go.kr).",
      srcTitle: "Fontes", viewNote: "👀 Só visualização: você pode ver o calendário, os marcos e as fotos da família, mas não pode alterá-los." };
const M = lang === "pt" ? M_PT : en
  ? { title: "Growth calendar & timeline | Baby milestones, vaccines, checkups", desc: "Enter your baby's birth date to see milestones, Korea's vaccine and checkup dates, and keep growth photos on this device.",
      h1: "Growth calendar & timeline", sub: "Milestones, Korea's national vaccines and infant checkups by age, with dates worked out from your baby's birth date.",
      birthQ: "Baby's date of birth", save: "Save", change: "Change birth date", setupNote: "Stored on this device (browser). With a family code, the birth date and photos are shared with your family.",
      tabTl: "Timeline", tabPh: "Photos", upTitle: "Coming up", addPh: "Add photos", exportPh: "Download all (ZIP)",
      disc: "Every child develops at their own pace. Milestones are from the U.S. CDC (things most children, 75% or more, do by that age) and are not a screening tool. If your child loses skills they once had or anything worries you, talk to a pediatrician. Vaccine and checkup dates are recommended timings worked out from the birth date; confirm your actual schedule with your clinic or the KDCA Immunization Helper (nip.kdca.go.kr).",
      srcTitle: "Sources", viewNote: "👀 View-only: you can see your family's growth calendar, milestones and photos, but not change them." }
  : { title: "성장 캘린더 & 타임라인 | 발달·예방접종·건강검진 일정", desc: "아기 생일을 넣으면 개월별 발달 이정표, 국가예방접종·영유아 건강검진 날짜를 계산해 주고 성장 사진을 기기에 보관해요.",
      h1: "성장 캘린더 & 타임라인", sub: "개월별 발달 이정표와 국가예방접종·영유아 건강검진 일정을 아기 생일 기준 날짜로 보여드려요.",
      birthQ: "아기 생년월일", save: "저장", change: "생일 바꾸기", setupNote: "이 기기(브라우저)에 저장돼요. 가족코드가 연결되어 있으면 가족과 생일·사진이 함께 맞춰져요.",
      tabTl: "타임라인", tabPh: "성장 사진", upTitle: "다가오는 일정", addPh: "사진 추가", exportPh: "전체 내려받기 (ZIP)",
      disc: "아이마다 발달 속도는 달라요. 발달 이정표는 미국 CDC 기준으로 '대부분(75% 이상)의 아이가 그 나이까지 하는 것'이며 진단 도구가 아니에요. 할 수 있던 것을 못 하게 되었거나 걱정되면 소아청소년과 의사와 상담하세요. 예방접종·검진 날짜는 생일로 계산한 권장 시기이며, 실제 일정은 의료기관이나 예방접종도우미(nip.kdca.go.kr)에서 확인하세요.",
      srcTitle: "출처", viewNote: "👀 보기 전용이에요. 가족의 성장 캘린더·이정표·사진을 볼 수만 있어요." };
---
<Base appTitle={APP_NAME} lang={lang} title={M.title} description={M.desc} path="/growth" tab="growth">
  <h1 class="h-title">{M.h1}</h1>
  <p class="h-sub">{M.sub}</p>
  <p class="g-view-note" id="g-view-note-top">{M.viewNote}</p>
  <script is:inline>try { var f = JSON.parse(localStorage.getItem("nb_tracker_v1_family") || "null"); if ((f && f.role === "view") || (!f && localStorage.getItem("nb_tracker_v1_viewgone"))) document.body.classList.add("g-viewonly"); } catch (e) {}</script>

  <section class="g-card" id="g-setup" hidden aria-labelledby="g-setup-h">
    <h2 class="g-h2" id="g-setup-h">🎂 {M.birthQ}</h2>
    <div class="g-quick">
      <button type="button" class="g-qchip" data-quick="0">👶 {t3("오늘 태어났어요", "Born today", "Nasceu hoje")}</button>
      <button type="button" class="g-qchip" data-quick="1">{t3("어제", "Yesterday", "Ontem")}</button>
      <button type="button" class="g-qchip g-hint" id="g-hint" hidden></button>
    </div>
    <div class="g-ymd" role="group" aria-label={M.birthQ}>
      <label><select id="g-y" class="g-sel" aria-label={t3("년", "Year", "Ano")}></select><span>{t3("년", "", "")}</span></label>
      <label><select id="g-m" class="g-sel" aria-label={t3("월", "Month", "Mês")}></select><span>{t3("월", "", "")}</span></label>
      <label><select id="g-d" class="g-sel" aria-label={t3("일", "Day", "Dia")}></select><span>{t3("일", "", "")}</span></label>
    </div>
    <div class="g-agein">
      <span>{t3("또는 우리 아기는 생후", "or: my baby is", "ou: meu bebê tem")}</span>
      <input type="number" id="g-age-n" class="g-input g-num" inputmode="numeric" min="0" max="1500" placeholder={t3("예: 93", "e.g. 93", "ex.: 93")} aria-label={t3("생후 나이", "Age", "Idade")} />
      <select id="g-age-u" class="g-sel g-unit" aria-label={t3("단위", "Unit", "Unidade")}>
        <option value="dplus">{t3("일째 (D+)", "days (Day N)", "dias (dia N)")}</option>
        <option value="weeks">{t3("주", "weeks old", "semanas")}</option>
        <option value="months">{t3("개월", "months old", "meses")}</option>
      </select>
    </div>
    <p class="g-confirm" id="g-confirm" aria-live="polite"></p>
    <p class="g-err" id="g-err" hidden></p>
    <div class="g-row g-setup-act">
      <button type="button" class="g-btn g-big" id="g-save">{t3("이 날짜로 저장", "Save this date", "Salvar esta data")}</button>
      <button type="button" class="g-btn g-ghost" id="g-cancel" hidden>{t3("취소", "Cancel", "Cancelar")}</button>
    </div>
    <p class="g-mini" id="g-setup-note">{M.setupNote}</p>
  </section>

  <section class="g-card g-now" id="g-now" hidden aria-live="polite"></section>

  <div class="g-seg" id="g-seg" hidden role="tablist">
    <button type="button" role="tab" id="g-tab-tl" aria-selected="true">{M.tabTl}</button>
    <button type="button" role="tab" id="g-tab-ph" aria-selected="false">{M.tabPh} <span id="g-ph-n"></span></button>
  </div>

  <div id="g-pane-tl" hidden>
    <section class="g-card" id="g-cal-card" aria-labelledby="g-cal-h">
      <div class="g-cal-head">
        <button type="button" class="g-cal-nav" id="g-cal-prev" aria-label={t3("이전 달", "Previous month", "Mês anterior")}>‹</button>
        <h2 class="g-h2" id="g-cal-h"></h2>
        <button type="button" class="g-cal-nav" id="g-cal-next" aria-label={t3("다음 달", "Next month", "Próximo mês")}>›</button>
      </div>
      <div class="g-cal-dows" aria-hidden="true" id="g-cal-dows"></div>
      <div class="g-cal-grid" id="g-cal" role="grid"></div>
      <div class="g-cal-leg" id="g-cal-leg"></div>
      <div class="g-day" id="g-day" hidden></div>
    </section>
    <section class="g-card" id="g-up-card"><h2 class="g-h2">📅 {M.upTitle}</h2><ul class="g-up" id="g-up"></ul></section>
    <section class="g-card" id="g-ms-card" aria-labelledby="g-ms-h">
      <h2 class="g-h2" id="g-ms-h"></h2>
      <p class="g-mini" id="g-ms-sub"></p>
      <div id="g-ms"></div>
    </section>
    <div class="g-tl" id="g-tl"></div>
  </div>

  <div id="g-pane-ph" hidden>
    <section class="g-card">
      <div class="g-row g-ph-act">
        <label class="g-btn" for="g-file">📷 {M.addPh}</label>
        <button type="button" class="g-btn g-ghost" id="g-export">⬇️ {M.exportPh}</button>
      </div>
      <p class="g-phnote" id="g-phnote-local">🔒 {t3("사진은 이 기기에만 저장돼요. 가족코드를 연결하면 가족과 함께 볼 수 있어요. 브라우저 데이터를 지우거나 휴대폰을 바꾸면 사라지니 가끔 전체 내려받기로 백업해 두세요.", "Photos stay on this device only until you connect a family code. Clearing browser data or switching phones will lose them — download a ZIP backup now and then.", "As fotos ficam só neste aparelho até você conectar um código da família. Limpar os dados do navegador ou trocar de celular apaga as fotos — baixe um backup em ZIP de vez em quando.")} <a href={lp("/tracker", lang)} class="g-famlink">{t3("가족코드를 연결하면 가족과 사진을 함께 볼 수 있어요 →", "Connect a family code to share photos with your family →", "Conecte um código da família para compartilhar fotos com a família →")}</a></p>
      <div class="g-fam" id="g-fam" hidden>
        <p class="g-fam-h">{t3("아기 기록의 가족코드로 가족과 사진을 나눠요. 가족코드가 있어야만 볼 수 있고, 공개 주소는 없어요.", "Shared with your family through the tracker family code. Photos are private to that code — there is no public link.", "Compartilhado com a família pelo código do diário. As fotos são privadas desse código — não há link público.")}</p>
        <p class="g-mini g-fam-st" id="g-fam-st" role="status"></p>
        <div class="g-fam-offer" id="g-fam-offer" hidden>
          <p id="g-fam-offer-t"></p>
          <div class="g-row"><button type="button" class="g-btn" id="g-fam-share"></button><button type="button" class="g-btn g-ghost" id="g-fam-later">{t3("나중에", "Not now", "Agora não")}</button></div>
        </div>
      </div>
      <p class="g-mini" id="g-ph-status" role="status" hidden></p>
    </section>
    <div id="g-gal"></div>
  </div>

  <input type="file" id="g-file" accept="image/*" multiple hidden />

  <div class="g-view" id="g-view" hidden role="dialog" aria-modal="true">
    <div class="g-view-in">
      <button type="button" class="g-view-x" id="g-view-x" aria-label={t3("닫기", "Close", "Fechar")}>✕</button>
      <img id="g-view-img" alt="" />
      <p class="g-view-age" id="g-view-age"></p>
      <p class="g-mini g-view-by" id="g-view-by" hidden></p>
      <label class="g-lbl" for="g-view-date">{t3("사진 날짜", "Photo date", "Data da foto")}</label>
      <input type="date" id="g-view-date" class="g-input" />
      <label class="g-lbl" for="g-view-note">{t3("메모", "Note", "Nota")}</label>
      <textarea id="g-view-note" class="g-input" rows="2" maxlength="300" placeholder={t3("예: 처음 웃었어요!", "e.g. First smile!", "ex.: Primeiro sorriso!")}></textarea>
      <div class="g-row g-view-act">
        <button type="button" class="g-btn" id="g-view-save">{t3("저장", "Save", "Salvar")}</button>
        <a class="g-btn g-ghost" id="g-view-dl" href="#" download>⬇️ {t3("내려받기", "Download", "Baixar")}</a>
        <button type="button" class="g-btn g-danger" id="g-view-del">{t3("삭제", "Delete", "Apagar")}</button>
      </div>
    </div>
  </div>

  <p class="g-mini" id="g-status" role="status" hidden></p>
  <p class="g-disc">{M.disc}</p>
  <section class="g-src"><h2>{M.srcTitle}</h2><ul>{SOURCES.map((s) => <li><a href={s.url} target="_blank" rel="noopener">{lang === "pt" ? s.pt || s.en : en ? s.en : s.ko}</a></li>)}</ul></section>

</Base>

<script>
  import { BANDS, MILESTONES } from "../lib/growth-data.js";
  import { parseYMD, fmtYMD, todayYMD, ageOn, bandFor, bandRange, scheduleFor, upcoming, photoAge, diffDays, addDays, daysInMonth, yearsFor, birthFromAge, earliestRecord, monthView, milestonesFor, milestoneId, customList, customEventsOn, newCustomId, cleanCustomText, CUSTOM_TEXT_MAX } from "../lib/growth-core.js";
  import { exifDate, makeZip, photoList, photoPut, photoDelete, resizeImage } from "../lib/growth-photos.js";
  import { T_PT, MON_PT } from "../lib/growth-i18n-pt.js";
  import { famInfo, makeApi, syncBirth, syncMarks, syncCustoms, syncPhotos, FAM_KEY } from "../lib/growth-sync.js";

  const LG = document.body.dataset.lang === "pt" ? "pt" : document.body.dataset.lang === "en" ? "en" : "ko";
  const EN = LG !== "ko", PT = LG === "pt"; // EN = any non-Korean page (pt falls back to English where not translated)
  const LS = "nb_growth_v1";
  const $ = (id) => document.getElementById(id);
  const esc = (s) => String(s == null ? "" : s).replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]);
  const MON = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
  const fmtD = (s) => { const p = parseYMD(s); return !p ? "" : PT ? `${String(p.d).padStart(2, "0")}/${String(p.m).padStart(2, "0")}/${p.y}` : EN ? `${MON[p.m - 1]} ${p.d}, ${p.y}` : `${p.y}.${String(p.m).padStart(2, "0")}.${String(p.d).padStart(2, "0")}`; };
  const T_EN = {
    now: (dp, d, m, r) => [`Day ${dp}`, `${d} ${d === 1 ? "day" : "days"} old · ${m} ${m === 1 ? "month" : "months"} ${r} ${r === 1 ? "day" : "days"}`],
    band: (b) => b.id === "after" ? "36 months +" : `${b.from}–${b.to} months`, bandNow: "Now", bandPast: "Done", bandNext: "Ahead",
    nowIn: (b) => `Now in the ${b} stage`, born: (d) => `Born ${d}`,
    dIn: (n) => n === 0 ? "Today" : `In ${n} ${n === 1 ? "day" : "days"}`, open: (d) => `Open now · until ${d}`,
    win: (a, b) => a === b ? a : `${a} – ${b}`, done: "Done", markDone: "Mark done", undo: "Undo", past: "Past",
    noneUp: "No more scheduled items in this calendar.", ms: (m) => `By ${m} months, most children:`,
    cat: { social: "Social / emotional", language: "Language / communication", cognitive: "Learning / thinking", movement: "Movement / physical" },
    play: "Things to try together", photos: "Photos from this time", addHere: "Add photo",
    before: "Before birth", phAge: (a) => a.before ? "Before birth" : `Day ${a.dplus} · ${a.months} mo ${a.restDays} d`, noPh: "No photos yet. Add one and it lands on the right month automatically.",
    added: (n) => `Added ${n} ${n === 1 ? "photo" : "photos"} (dated from the photo info when available).`, adding: "Saving photos…", confirmDel: "Delete this photo from this device?", nothingExp: "No photos to download yet.", saved: "Saved",
    famSyncing: "Syncing with your family…", famOk: (n) => `Up to date · ${n} ${n === 1 ? "photo" : "photos"} in the family album`, famOff: "Offline · photos stay on this device and upload when you're back online.",
    famPend: (n) => `${n} waiting to upload`, famGone: "This family code is no longer valid. Photos stay on this device.", famErr: (n) => `${n} couldn't be shared (too large or not a photo).`,
    offer: (n) => `${n} ${n === 1 ? "photo is" : "photos are"} only on this device. Share ${n === 1 ? "it" : "them"} with your family?`, shareBtn: (n) => `Share ${n} with family`,
    confirmDelShared: "Delete this photo for everyone in your family?", by: (n) => `Added by ${n}`, byFam: "Added by family",
    badge: { yes: "Shared with family", pending: "Waiting to upload", err: "Not shared" },
    errFuture: "The birth date can't be in the future.", errBad: "Please enter a valid date.",
    after: "Past 36 months: next are DTaP 5 · IPV 4 · MMR 2 at ages 4–6, Japanese encephalitis at 6, and checkups at 42–48, 54–60 and 66–71 months.",
    kind: { vax: "Vaccine", check: "Checkup", benefit: "Benefit", day: "Day" }, d100: (n) => n > 0 ? `100th day in ${n} days` : "",
    ph: { y: "Year", m: "Month", d: "Day" }, mon: (m) => MON[m - 1], day: (d) => String(d),
    confirm: (d, a) => `Born ${d} · today is Day ${a.dplus} (${a.months} mo ${a.restDays} d)`, pick: "Pick the year, month and day, or tap a button above.",
    hint: (d) => `📒 First tracker record: ${d}`, ageBad: "Enter a number (days up to 1500, weeks up to 210, months up to 48).",
    birthFromFam: "Birth date updated from your family.",
    calTitle: (y, m) => `${MON[m - 1]} ${y}`,
    dows: ["S", "M", "T", "W", "T", "F", "S"],
    leg: "Today · 100th day · First birthday · Items on that day",
    dayEmpty: "Nothing scheduled this day.",
    dayItems: (d) => `On ${d}`,
    dayAddPh: "Add a photo for this day",
    todayLab: "Today",
    selLeg: "Selected",
    daySwipe: "Swipe to see more",
    addedOn: (n, d) => `Added ${n} ${n === 1 ? "photo" : "photos"} for ${d}.`,
    msTitle: "Milestones",
    msSub: "Updates with your baby's age. Tap to mark one as achieved.",
    msNow: "This stage (now)",
    msWeek: "This week / now",
    msPast: "Earlier stages",
    msNext: "Coming stages",
    msAchieved: "Achieved",
    msMark: "Mark achieved",
    msUndo: "Undo",
    msWhen: "When? (optional)",
    msSave: "Save",
    msCancel: "Cancel",
    msNone: "No milestones in this list.",
    msCustom: "Custom",
    msCustomAdd: "Add your own",
    msCustomPh: "e.g. Tried rolling over for the first time",
    msCustomDate: "Date (optional)",
    msCustomSave: "Add",
    msCustomEdit: "Edit",
    msCustomDel: "Delete",
    msCustomEmpty: "Type something your baby did in this stage.",
    msCustomTooLong: "Keep it under 80 characters.",
    msCustomNeed: "Please type a short note first.",
    dayAddMs: "Write a milestone for this day", msOnCal: "Shown on the calendar", msNoDate: "Add a date to show it on the calendar", msCdc: "Milestone",
    customsFromFam: "Custom milestones updated from your family.",
    marksFromFam: "Milestone marks updated from your family.",
    w: { day: "Day ", photo: (n) => (n === 1 ? " photo" : " photos"), d100: "100th day", dol: "First birthday", photoLeg: "Photo", close: "Close", change: "Change" },
  };
  const T_KO = {
    now: (dp, d, m, r) => [`D+${dp}`, `생후 ${d}일 · ${m}개월 ${r}일`],
    band: (b) => b.id === "after" ? "36개월 이후" : `${b.from}~${b.to}개월`, bandNow: "지금", bandPast: "지남", bandNext: "예정",
    nowIn: (b) => `지금은 ${b} 시기예요`, born: (d) => `${d} 출생`,
    dIn: (n) => n === 0 ? "오늘" : `D-${n}`, open: (d) => `지금 기간 · ${d}까지`,
    win: (a, b) => a === b ? a : `${a} ~ ${b}`, done: "완료", markDone: "완료 표시", undo: "취소", past: "지남",
    noneUp: "이 캘린더에 남은 일정이 없어요.", ms: (m) => `${m}개월 무렵 대부분의 아이가 해요`,
    cat: { social: "사회성·정서", language: "언어·의사소통", cognitive: "인지(학습·생각)", movement: "운동·신체" },
    play: "함께 해 볼 놀이", photos: "이 시기 사진", addHere: "사진 추가",
    before: "출생 전", phAge: (a) => a.before ? "출생 전" : `D+${a.dplus} · ${a.months}개월 ${a.restDays}일`, noPh: "아직 사진이 없어요. 사진을 추가하면 찍은 날짜에 맞는 개월에 자동으로 정리돼요.",
