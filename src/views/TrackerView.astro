    mvErr(""); $("mv-start").hidden = true; $("mv-out").hidden = true; $("mv-q").textContent = MV.making; $("mv-q").hidden = false;
    try {
      if (!Sync.joined) { Sync.setNick($("fam-nick").value); await Sync.create(); ga("tracker_family", { action: "create_for_move" }); }
      mvShow(await Sync.moveCode()); ga("tracker_family", { action: "move_code" });
    } catch (e) { $("mv-q").hidden = true; mvErr(famErr(e)); $("mv-start").textContent = mvStartTx; $("mv-start").hidden = false; }
  }
  function openMove(focusIn) {
    $("mv-sheet").hidden = false; $("mv-bg").hidden = false; hideToast(); mvErr("");
    const has = entries.length > 0;
    $("mv-send").hidden = !Sync.joined && !has; // nothing here to send: only show "bring a log here"
    if (mvCur && mvCur.expires > Date.now() + 60000) mvShow(mvCur);
    else if (Sync.joined) mvMake();
    else if (has) { $("mv-out").hidden = true; $("mv-q").textContent = MV.startQ; $("mv-q").hidden = false; $("mv-start").textContent = mvStartTx; $("mv-start").hidden = false; }
    if (focusIn || $("mv-send").hidden) setTimeout(() => $("mv-in").focus(), 60);
  }
  const closeMove = () => { $("mv-sheet").hidden = true; $("mv-bg").hidden = true; };
  async function mvClaim(input) {
    const j = T.joinInput(input);
    if (!j) { const e = new Error("bad_move"); e.code = "bad_move"; throw e; }
    if (Sync.joined) {
      if (j.code && j.code === Sync.code) { closeMove(); toast(MV.sameFam, [], 3000); return; }
      if (!j.move) { const e = new Error("already"); e.code = "already"; throw e; }
      // a move code while already in a family (e.g. two phones ended up in two families after 새 코드): offer to switch
      const chk = await Sync.checkMove(j.move); // throws expired_move / bad_move before asking anything
      if (chk.same) { $("mv-in").value = ""; closeMove(); toast(MV.sameFam, [], 3000); return; }
      if (!confirm(MV.switchAsk(Sync.memberCount || 1))) return;
      Sync.setNick($("fam-nick").value); await Sync.switchClaim(j.move); ga("tracker_family", { action: "move_switch" });
      $("mv-in").value = ""; closeMove(); goTracker(); toast(MV.switched(entries.length), [], 5000); return;
    }
    Sync.setNick($("fam-nick").value);
    if (j.move) await Sync.claim(j.move); else await Sync.join(j.code);
    ga("tracker_family", { action: j.move ? "move_claim" : "join" });
    $("mv-in").value = ""; closeMove(); goTracker(); toast(j.move ? MV.claimed(entries.length) : F.joined, [], 4000);
  }
  $("mv-btn").onclick = () => openMove(false);
  $("mv-close").onclick = closeMove; $("mv-bg").onclick = closeMove;
  $("mv-start").onclick = mvMake;
  $("mv-form").onsubmit = (ev) => { ev.preventDefault(); busyBtn($("mv-go"), () => mvClaim($("mv-in").value)); };
  $("mv-copy").onclick = async () => {
    if (!mvCur) return;
    try { await navigator.clipboard.writeText(mvLink(mvCur.move)); toast(MV.copied, [], 2500); }
    catch { const r = document.createRange(); r.selectNodeContents($("mv-code")); const sel = getSelection(); sel.removeAllRanges(); sel.addRange(r); toast(F.copyFail, [], 3000); }
    ga("tracker_family", { action: "move_copy" });
  };
  $("mv-share").hidden = !navigator.share;
  $("mv-share").onclick = async () => { if (mvCur) try { await navigator.share({ title: MV.shareTitle, text: MV.shareText, url: mvLink(mvCur.move) }); ga("tracker_family", { action: "move_share" }); } catch {} };
  // "used it somewhere else?" — shown while this place has no log yet (fresh browser, iPhone home-screen app, ...)
  $("mv-hint-tx").textContent = MV.hint; $("mv-hint-sub").textContent = MV.hintSub; $("mv-hint-go").textContent = MV.hintGo;
  $("mv-hint-go").onclick = () => openMove(true);
  const mvHintOff = () => { try { return !!localStorage.getItem(T.STORAGE_KEY + "_mvhint_x"); } catch { return false; } };
  window.__mvHint = () => { $("mv-hint").hidden = Sync.joined || entries.length > 0 || mvHintOff(); };
  $("mv-hint-x").onclick = () => { try { localStorage.setItem(T.STORAGE_KEY + "_mvhint_x", "1"); } catch {} $("mv-hint").hidden = true; };
  window.__mvHint();
  // ---------- big "tap and speak" gate (fallback only when an explicit ?shortcut=voice auto-listen did not get the mic) ----------
  function showGate(why) {
    if (!SR || viewOnly()) return;
    $("voice-gate").hidden = false; document.body.classList.add("tk-gated");
    if (!$("say-banner").hidden && $("say-banner").dataset.tone === "info") hideBanner();
    ga("tracker_voice", { result: "gate", why: why || "" });
    setTimeout(() => $("gate-go").focus(), 30);
  }
  function hideGate() { if ($("voice-gate").hidden) return; $("voice-gate").hidden = true; document.body.classList.remove("tk-gated"); hideVoice(); }
  $("gate-go").onclick = () => { $("voice-gate").hidden = true; document.body.classList.remove("tk-gated"); hideBanner(); showVoice(); mic.click(); };
  $("gate-x").onclick = hideGate;
  // ---------- URL commands: /tracker?say=분유%20100 (Bixby) and /tracker?shortcut=voice (explicit listen shortcut) ----------
  // The URL carries only the action; the record goes into this browser's own log (and its family, if sharing is on).
  // ?voice=1 is a leftover from the pre-11/14 PWA start_url (/tracker?voice=1). Installed Android WebAPKs keep that
  // start_url, so treating it as "open the mic" would show the card every time the app icon is tapped. Strip it, ignore it.
  const S = L.say;
  const qp = new URLSearchParams(location.search);
  const sayRaw = qp.get("say"), shortcutVoice = qp.get("shortcut") === "voice", staleVoice = qp.get("voice");
  if (sayRaw != null || staleVoice != null || qp.has("shortcut")) { // drop the command so a reload / back can't fire it twice
    qp.delete("say"); qp.delete("voice"); qp.delete("shortcut"); const q = qp.toString();
    history.replaceState(null, "", location.pathname + (q ? "?" + q : "") + location.hash);
  }
  var famWatch = false; // var: famBannerUpdate can run (via renderFam) before this line
  function banner(text, sub, actions = [], tone = "ok") {
    $("say-tx").textContent = text; $("say-sub").textContent = sub || ""; $("say-sub").hidden = !sub;
    const b = $("say-banner"); b.dataset.tone = tone;
    const act = $("say-act"); act.innerHTML = "";
    for (const [label, fn, cls] of actions) { const x = document.createElement("button"); x.type = "button"; x.textContent = label; if (cls) x.className = cls; x.onclick = fn; act.appendChild(x); }
    b.hidden = false;
  }
  function hideBanner() { $("say-banner").hidden = true; famWatch = false; }
  $("say-x").onclick = hideBanner;
  const readLastSay = () => { try { return JSON.parse(localStorage.getItem(T.SAY_KEY) || "null"); } catch { return null; } };
  const famLine = () => !Sync.joined ? S.famOff : navigator.onLine === false ? S.famOffline : S.famSending;
  function famBannerUpdate(st) {
    if (!famWatch || $("say-banner").hidden) return;
    if (!st.joined) { $("say-sub").textContent = S.famOff; return; }
    if (st.status === "synced" && !st.pending) { $("say-sub").textContent = S.famSent; $("say-sub").dataset.s = "sent"; famWatch = false; }
    else if (st.status === "offline") $("say-sub").textContent = S.famOffline;
  }
  function sayCommit(cmds, text) {
    if (viewOnly()) { banner(L.fam.viewOnlyToast, "", [], "warn"); return false; }
    const { list, done, changes, note } = applyCmds(cmds);
    if (!done.length) { banner(S.notSaved(note || L.cantLog), "", [], "warn"); ga("tracker_say", { result: "error" }); return false; }
    entries = list; save();
    try { localStorage.setItem(T.SAY_KEY, JSON.stringify({ k: T.sayKey(text), at: Date.now() })); } catch {}
    for (const [c] of done) ga("tracker_log", { type: c.action === "sleep" ? "sleep" : c.action, method: "url", ...(c.kind ? { kind: c.kind } : {}), ...(c.d ? { diaper: c.d } : {}), ...(c.ml ? { ml: c.ml } : {}) });
    ga("tracker_say", { result: "saved", action: done.map(([c]) => c.action).join("+") });
    $("say-sub").dataset.s = "";
    const last = done[done.length - 1];
    banner(S.done(done.map(([c]) => S.label(c)).join(" · "), L.clock(last[0].action === "sleep" ? last[0].end : last[0].t)) + (note ? ` (${note})` : ""), famLine(), [
      [S.undo, () => { undoChanges(changes); try { localStorage.removeItem(T.SAY_KEY); } catch {} ga("tracker_say", { result: "undone" }); famWatch = false; banner(S.undone, "", [], "muted"); }, "undo"],
      [S.edit, () => { const e = entries.find((x) => x.id === last[1].id); if (e) openSheet(e.type, e); }],
    ], "ok");
    famWatch = true;
    if (Sync.joined) Sync.sync(); // push right away instead of waiting for the debounce / 20 s poll
    return true;
  }
  if (sayRaw != null) {
    const text = T.cleanSay(sayRaw), now = Date.now();
    const cmds = text ? T.parseCommands(text, now, LANG) : [];
    if (!cmds.length) {
      banner(S.unparsed(text || "?"), "", [], "warn"); $("typed-wrap").open = true; $("typed-in").value = text;
      ga("tracker_say", { result: "unparsed" });
    } else if (cmds.length === 1 && T.needsDetail(cmds[0])) {
      banner(S.needDetail(S.label(cmds[0])), "", [], "warn"); openSheet("feed", null); seg("sh-kind", cmds[0].kind); showFields();
      ga("tracker_say", { result: "need_detail" });
    } else if (!applyCmds(cmds).done.length) { // e.g. "깼어" with no running sleep: say why instead of asking about duplicates
      sayCommit(cmds, text);
    } else if (T.isRecentSay(readLastSay(), text, now)) {
      const label = cmds.map((c) => S.label(c)).join(" · ");
      banner(S.dupQ(label), "", [[S.dupYes, () => { sayCommit(T.parseCommands(text, Date.now(), LANG), text); }, "ok"], [S.dupNo, () => { banner(S.dupSkipped, "", [], "muted"); ga("tracker_say", { result: "dup_skipped" }); }]], "warn");
      ga("tracker_say", { result: "dup_asked" });
    } else sayCommit(cmds, text);
  } else if (shortcutVoice && !viewOnly()) {
    ga("tracker_say", { result: "voice_open" });
    if (SR) { showVoice(); banner(S.voiceAsk, "", [[S.voiceGo, () => { hideBanner(); mic.click(); }, "ok"]], "info"); startMic(true); }
    else { showVoice(); banner(S.voiceNoSr, "", [], "warn"); $("typed-wrap").open = true; $("typed-in").focus(); }
  }
  // stale ?voice=1 (old PWA start_url): already stripped, panel stays closed

  // move link: /tracker#move=CODE (QR / copied link) or ?move=CODE (Android "open in Chrome" hand-off). Strip it right away.
  function mvFromUrl() {
    const qs = new URLSearchParams(location.search);
    const hm = location.hash.match(/^#move=([0-9A-Za-z-]+)/);
    const m = qs.get("move") || (hm && hm[1]);
    const openOnly = location.hash === "#openmove";
    if (!m && !openOnly) return;
    qs.delete("move"); const rest = qs.toString();
    history.replaceState(null, "", location.pathname + (rest ? "?" + rest : "") + (hm || openOnly ? "" : location.hash));
    if (openOnly) { openMove(false); return; }
    if (Sync.joined) { openMove(true); $("mv-in").value = T.fmtMoveCode(m) || m; mvClaim(m).catch((e) => toast(famErr(e), [], 6000)); return; } // asks before switching
    toast(MV.claiming, [], 15000);
    mvClaim(m).catch((e) => { hideToast(); openMove(true); $("mv-in").value = T.fmtMoveCode(m) || m; toast(famErr(e), [], 6000); });
  }
  mvFromUrl();
  addEventListener("hashchange", mvFromUrl);
  // invite link: /tracker#join=CODE (old: ?join=CODE). A VIEW-ONLY code joins by itself (nothing of this device is shared, and
  // a closed sheet must not leave the person on an editable log that the family never sees); a full code still needs a tap.
  function joinFromUrl() {
    const joinHash = location.hash.match(/^#join=([0-9A-Za-z-]+)/);
    const joinParam = new URLSearchParams(location.search).get("join") || (joinHash && joinHash[1]);
    if (!joinParam) return;
    history.replaceState(null, "", location.pathname + (joinHash ? "" : location.hash));
    const c = T.codeFromInput(joinParam);
    if (!c) { toast(F.badCode, [], 4000); return; }
    if (c === Sync.code) { toast(F.alreadyIn, [], 3500); return; } // already a member: just stay on the log
    const showInvite = (view) => { $("fam-join-in").value = T.fmtFamilyCode(c); $("fam-invite").textContent = Sync.joined ? F.invitedOther : view ? F.invitedView : F.invited; $("fam-invite").hidden = false; $("fam-sheet").classList.toggle("tk-invited", !Sync.joined); openFam(); };
    if (Sync.joined) { showInvite(false); return; }
    Sync.peek(c).then(async (r) => {
      if (!r || r.role !== "view") { showInvite(false); return; }
      const wasCut = Sync.cut;
      try { await Sync.join(c); ga("tracker_family", { action: "join_view", auto: 1 }); goTracker(); toast(wasCut ? F.joinedViewCut : F.joinedView, [], wasCut ? 9000 : 5000); render(); }
      catch { showInvite(true); }
    }, () => showInvite(false));
  }
  joinFromUrl();
  addEventListener("hashchange", () => { if (/^#join=/.test(location.hash)) joinFromUrl(); });
  // polling while visible + on focus / back online
  setInterval(() => { if (Sync.joined && !document.hidden) Sync.sync(); }, 20000);
  window.addEventListener("focus", () => Sync.joined && Sync.sync());
  window.addEventListener("online", () => Sync.joined && Sync.sync());
  window.addEventListener("offline", () => Sync.joined && Sync.sync());
  document.addEventListener("visibilitychange", () => { if (!document.hidden && Sync.joined) Sync.sync(); });
  Sync.state();
  if (Sync.joined) Sync.sync();
  render();
</script>

