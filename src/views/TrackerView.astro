  // ---------- voice / typed commands ----------
  // Every phrase goes through T.parseCommands -> commitMany -> T.applyCommand -> save(): the same path as the buttons,
  // so family sync, the summary, the log and the 24h clock all update. Saved at once; the toast offers undo / edit time.
  let lastPhrase = { k: "", at: 0 }, hfOn = false, listening = false;
  const hfStatus = (msg) => { $("mic-sub").textContent = msg; };
  function handlePhrase(alts, method, conf) {
    const now = Date.now(), hf = method === "handsfree";
