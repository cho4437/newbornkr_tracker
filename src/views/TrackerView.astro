    if (viewOnly()) { toast(L.fam.viewOnlyToast, [], 2500); return false; }
    const { list, done, changes, note } = applyCmds(cmds);
    if (!done.length) { toast(note || L.cantLog); return false; }
    entries = list; save();
    for (const [c] of done) ga("tracker_log", { type: c.action === "sleep" ? "sleep" : c.action, method, ...(c.kind ? { kind: c.kind } : {}), ...(c.d ? { diaper: c.d } : {}), ...(c.ml ? { ml: c.ml } : {}) });
