---
import { APP_NAME, lp, tx } from "../lib/site";
import { ogImageFor } from "../lib/seo";
import Base from "../layouts/Base.astro";
import PwaHead from "../components/PwaHead.astro";
import { MARKUP, STR } from "../lib/tracker-i18n.js";
interface Props { lang: "ko" | "en" | "pt" }
const { lang } = Astro.props;
const M = MARKUP[lang];
const MVS = STR[lang].move;
---
<Base appTitle={APP_NAME} lang={lang} title={M.title} description={M.description} path="/tracker" tab="tracker" bodyClass="tk-body" ogImage={ogImageFor("tracker", lang)}>
  <PwaHead slot="head" lang={lang} />
  <div class="tk-gate" id="voice-gate" hidden role="dialog" aria-modal="true" aria-labelledby="gate-tx">
    <button type="button" class="tk-gate-go" id="gate-go"><span class="tk-gate-ic" aria-hidden="true">🎤</span><b id="gate-tx">{M.gateGo}</b><small>{M.gateSub}</small></button>
    <p class="tk-gate-why">{M.gateWhy}</p>
    <button type="button" class="tk-gate-x" id="gate-x">{M.gateClose}</button>
  </div>
  <div class="tk-head">
    <h1 class="tk-h1">{M.h1}</h1>
    <span class="tk-view-badge" id="view-badge">{M.viewBadge}</span>
    <span class="tk-fam-st" id="fam-status" hidden></span>
  </div>
  <p class="tk-sub">{M.sub}</p>
  <p class="tk-view-note" id="view-note">{M.viewNote}</p>
  <div class="tk-cut-note" id="cut-note" hidden><p id="cut-tx"></p><button type="button" id="cut-go"></button></div>
  <div class="tk-viewgone-note" id="viewgone-note"><p>{M.viewGoneNote}</p><button type="button" id="viewgone-unlock" data-ask={M.viewGoneUnlockAsk}>{M.viewGoneUnlock}</button></div>
  <div class="tk-say" id="say-banner" hidden role="status" aria-live="polite">
    <div class="tk-say-main"><b id="say-tx"></b><small id="say-sub" hidden></small></div>
    <div class="tk-say-act" id="say-act"></div>
    <button type="button" class="tk-say-x" id="say-x" aria-label={M.close}>✕</button>
  </div>
  <div class="tk-fam-row" role="group">
    <button type="button" class="tk-fam-btn" id="fam-btn">👨‍👩‍👧 {M.famBtn}</button>
    <button type="button" class="tk-fam-btn" id="fam-push-btn" aria-pressed="false">{M.famPushBtn}</button>
    <button type="button" class="tk-fam-btn tk-mv-btn" id="mv-btn">{M.mvBtn}</button>
  </div>
  <div class="tk-mv-hint" id="mv-hint" hidden><span><b id="mv-hint-tx">{MVS.hint}</b><small id="mv-hint-sub">{MVS.hintSub}</small></span><button type="button" id="mv-hint-go">{MVS.hintGo}</button><button type="button" class="tk-mv-hint-x" id="mv-hint-x" aria-label={M.close}>✕</button></div>

  <div class="tk-since" id="tk-since" aria-live="polite">
    <div class="tk-chip" id="since-feed"><span>{M.sinceFeed}</span><b>-</b></div>
    <div class="tk-chip" id="since-sleep"><span>{M.sinceSleep}</span><b>-</b></div>
    <div class="tk-chip" id="since-diaper"><span>{M.sinceDiaper}</span><b>-</b></div>
  </div>

  <div class="tk-voice">
    <div class="tk-voice-panel" id="voice-box" hidden>
    <div class="tk-coach" id="coach" hidden>{M.coach}<button type="button" id="coach-x" aria-label={M.coachClose}>✕</button></div>
    <script is:inline>
      // Show first-visit hints before first paint (same rules as the module script below) so they don't shift the page (CLS).
      (function () { try {
        var K = "nb_tracker_v1", d = JSON.parse(localStorage.getItem(K) || "null");
        var fo = JSON.parse(localStorage.getItem(K + "_family") || "null"), has = d && Array.isArray(d.entries) && d.entries.length > 0, fam = !!fo;
        if (fo && fo.role === "view") document.body.classList.add("tk-view"); // view-only link: hide every add / edit control before first paint
        else if (!fo && localStorage.getItem(K + "_viewgone")) document.body.classList.add("tk-view", "tk-viewgone"); // its view link stopped working: still read-only
        if (!has && !fam && !localStorage.getItem(K + "_mvhint_x")) document.getElementById("mv-hint").hidden = false;
        var box = document.getElementById("voice-box"), fab0 = document.getElementById("fab");
        if (box) box.hidden = true; // speak-then-tap panel stays closed until 🎤 말로 기록 or an explicit ?shortcut=voice / ?say=
        if (fab0 && !document.body.classList.contains("tk-view")) fab0.hidden = false;
      } catch (e) {} })();
    </script>
    <button type="button" class="tk-mic" id="mic" aria-label={M.micAria}>
      <span class="tk-mic-ic" aria-hidden="true">🎤</span>
      <span class="tk-mic-tx"><b id="mic-label">{M.micLabel}</b><small id="mic-sub">{M.micSub}</small></span>
      <span class="tk-mic-go" aria-hidden="true">{M.micGo}</span>
    </button>
    <p class="tk-hint" id="mic-hint" hidden></p>
    <label class="tk-hf" id="hf-wrap" hidden>
      <input type="checkbox" id="hf-toggle" role="switch" />
      <span class="tk-hf-sw" aria-hidden="true"></span>
      <span class="tk-hf-tx"><b>{M.hfLabel} <em>{M.hfBeta}</em></b><small>{M.hfSub}</small></span>
    </label>
    </div>
    <a class="tk-setup-link" href={lp("/tracker/app", lang)}>{M.bixbyLink}</a>
    <details class="tk-typed tk-say-ex" id="say-ex">
      <summary>{M.sayTitle}</summary>
      <ul>{M.sayList.map((x) => <li>{x}</li>)}</ul>
    </details>
    <details class="tk-typed" id="typed-wrap">
      <summary>{M.typed}</summary>
      <form id="typed" autocomplete="off">
        <input id="typed-in" type="text" placeholder={M.typedPh} aria-label={M.typedAria} />
        <button type="submit">{M.typedOk}</button>
      </form>
    </details>
  </div>

  <div class="tk-quick">
    <button type="button" class="tk-btn tk-feed" id="q-feed"><span class="e">🍼</span><span class="l">{M.qFeed}</span></button>
    <button type="button" class="tk-btn tk-sleep" id="q-sleep"><span class="e">😴</span><span class="l">{M.qSleep}</span></button>
    <button type="button" class="tk-btn tk-pee" id="q-pee"><span class="e">💧</span><span class="l">{M.qPee}</span></button>
    <button type="button" class="tk-btn tk-poop" id="q-poop"><span class="e">💩</span><span class="l">{M.qPoop}</span></button>
    <button type="button" class="tk-btn tk-both" id="q-both"><span class="e">💩💧</span><span class="l">{M.qBoth}</span></button>
  </div>

  <section class="tk-card">
    <div class="tk-card-h"><h2>{M.sumTitle}</h2><span id="sum-date"></span></div>
    <div class="tk-sum">
      <div><b id="sum-ml">0</b><span>{M.sumFeeds[0]}<i id="sum-feeds">0</i><span id="sum-feeds-l">{M.sumFeeds[1]}</span></span></div>
      <div><b id="sum-sleep">{M.sumSleep}</b><span>{M.sumSleepL}</span></div>
      <div><b id="sum-pee">0</b><span>{M.sumPee}</span></div>
      <div><b id="sum-poop">0</b><span>{M.sumPoop}</span></div>
    </div>
  </section>

  <section class="tk-card tk-clk" id="clk-card">
    <div class="tk-card-h">
      <h2>🕒 {M.clkTitle}</h2>
      <div class="tk-seg tk-clk-mode" id="clk-mode" role="radiogroup" aria-label={M.clkModeAria}>
        <button type="button" data-v="day" role="radio" class="on" aria-checked="true">{M.clkDay}</button>
        <button type="button" data-v="tl" role="radio" aria-checked="false">{M.clkTl}</button>
        <button type="button" data-v="week" role="radio" aria-checked="false">{M.clkWeek}</button>
        <button type="button" data-v="cmp" role="radio" aria-checked="false">{M.clkCmp}</button>
      </div>
    </div>
    <div class="tk-clk-nav">
      <button type="button" class="tk-nav" id="clk-prev" aria-label={M.prevDay}>‹</button>
      <b id="clk-day"></b>
      <button type="button" class="tk-clk-today" id="clk-today" hidden>{M.clkToday}</button>
      <button type="button" class="tk-nav" id="clk-next" aria-label={M.nextDay}>›</button>
    </div>
    <div class="tk-clk-wrap"><svg id="clk-svg" class="ck-svg" viewBox="0 0 320 320" role="img" aria-label={tx(lang, "24시간 기록 시계", "24-hour log clock", "Relógio de registros de 24 horas")} xmlns="http://www.w3.org/2000/svg"></svg></div>
    <div class="tl2" id="tl2" hidden></div>
    <div class="cmp" id="cmp" hidden></div>
    <p class="tk-clk-hint" id="clk-hint" hidden></p>
    <ul class="tk-clk-legend">
      <li><i class="lg-sleep"></i>{M.clkLegend[0]}</li><li><i class="lg-formula"></i>{M.clkLegend[1]}</li><li><i class="lg-breast"></i>{M.clkLegend[2]}</li><li class="lg-d"><i class="lg-pee"></i>{M.clkLegend[3]}</li><li class="lg-d"><i class="lg-poop"></i>{M.clkLegend[4]}</li>
    </ul>
    <div class="tk-clk-stats" id="clk-stats"></div>
  </section>

  <section class="tk-card">
    <div class="tk-card-h">
      <button type="button" class="tk-nav" id="day-prev" aria-label={M.prevDay}>‹</button>
      <h2 id="tl-title">{M.tlTitle}</h2>
      <button type="button" class="tk-nav" id="day-next" aria-label={M.nextDay}>›</button>
    </div>
    <ol class="tk-tl" id="timeline"></ol>
    <p class="tk-empty" id="tl-empty">{M.empty}</p>
  </section>

  <section class="tk-card">
    <div class="tk-card-h"><h2>{M.histTitle}</h2></div>
    <table class="tk-hist">
      <thead><tr><th>{M.histCols[0]}</th><th>{M.histCols[1]}</th><th>{M.histCols[2]}</th><th>💧</th><th>💩</th></tr></thead>
      <tbody id="hist"></tbody>
    </table>
  </section>

  <section class="tk-card tk-fc" id="fc-card" aria-live="polite">
    <div class="tk-card-h"><h2>🔮 {M.fcTitle}</h2></div>
    <ul class="tk-fc-now" id="fc-now"></ul>
    <div class="tk-fc-next">
      <h3>⏱️ {M.fcNextTitle}</h3>
      <ul class="tk-fc-list" id="fc-next"></ul>
      <div class="tk-fc-why" id="fc-why" hidden></div>
    </div>
    <p class="tk-fc-more" id="fc-more" hidden></p>
    <p class="tk-fc-disc">{M.fcDisc}</p>
  </section>

  <section class="tk-card tk-data">
    <div class="tk-card-h"><h2>{M.dataTitle}</h2></div>
    <p class="tk-note">{M.dataNote}</p>
    <div class="tk-data-btns">
      <button type="button" id="d-export">{M.export}</button>
      <label class="tk-file">{M.import}<input type="file" id="d-import" accept="application/json,.json" hidden /></label>
      <button type="button" id="d-clear" class="danger">{M.clear}</button>
    </div>
  </section>

  <p class="tk-disc">{M.disc} {M.discShare}</p>

  <div class="tk-sheet-bg" id="sheet-bg" hidden></div>
  <form class="tk-sheet" id="sheet" hidden autocomplete="off">
    <div class="tk-sheet-h"><h3 id="sh-title">{M.shTitle}</h3><button type="button" class="tk-x" id="sh-close" aria-label={M.close}>✕</button></div>
    <div class="tk-f" data-for="feed">
      <div class="tk-seg" id="sh-kind" role="radiogroup" aria-label={M.kindAria}>
        <button type="button" data-v="formula" role="radio">{M.formula}</button>
        <button type="button" data-v="breast" role="radio">{M.breast}</button>
      </div>
    </div>
    <div class="tk-f" data-for="feed-ml">
      <label for="sh-ml">{M.mlLabel}</label>
      <div class="tk-chips" id="sh-ml-chips"></div>
      <div class="tk-step"><button type="button" class="tk-step-b" id="sh-ml-dec" aria-label={tx(lang, "5ml 줄이기", "5 ml less", "5 ml a menos")}>−</button><input id="sh-ml" type="number" inputmode="decimal" min="0" step="any" placeholder="ml" /><button type="button" class="tk-step-b" id="sh-ml-inc" aria-label={tx(lang, "5ml 늘리기", "5 ml more", "5 ml a mais")}>+</button></div>
    </div>
    <div class="tk-f" data-for="feed-min">
      <label for="sh-min">{M.minLabel}</label>
      <div class="tk-chips" id="sh-min-chips"></div>
      <input id="sh-min" type="number" inputmode="numeric" min="0" max="300" placeholder={M.minPh} />
    </div>
    <div class="tk-f" data-for="diaper">
      <div class="tk-seg" id="sh-d" role="radiogroup" aria-label={M.diaperAria}>
        <button type="button" data-v="pee" role="radio">{M.pee}</button>
        <button type="button" data-v="poop" role="radio">{M.poop}</button>
        <button type="button" data-v="both" role="radio">{M.both}</button>
      </div>
    </div>
    <div class="tk-f" data-for="time"><label for="sh-t" id="sh-t-label">{M.time}</label><input id="sh-t" type="datetime-local" required /></div>
    <div class="tk-f" data-for="end"><label for="sh-end">{M.end} <small>{M.endHint}</small></label><input id="sh-end" type="datetime-local" /></div>
    <button type="submit" class="tk-save" id="sh-save">{M.save}</button>
    <button type="button" class="tk-del" id="sh-del" hidden>{M.del}</button>
  </form>

  <div class="tk-sheet-bg" id="fam-bg" hidden></div>
  <section class="tk-sheet tk-fam" id="fam-sheet" hidden aria-labelledby="fam-title">
    <div class="tk-sheet-h"><h3 id="fam-title">👨‍👩‍👧 {M.famTitle}</h3><button type="button" class="tk-x" id="fam-close" aria-label={M.close}>✕</button></div>
    <p class="tk-fam-intro">{M.famIntro}</p>
    <p class="tk-hint" id="fam-invite" hidden></p>
    <div class="tk-f"><label for="fam-nick">{M.famNick}</label>
      <div class="tk-fam-inline"><input id="fam-nick" type="text" maxlength="20" placeholder={M.famNickPh} autocomplete="off" /><button type="button" id="fam-nick-save" class="tk-fam-sec" hidden>{M.famSaveNick}</button></div></div>
    <div id="fam-off">
      <p class="tk-fam-cut" id="fam-cut" hidden></p>
      <button type="button" class="tk-save" id="fam-create">{M.famCreate}</button>
      <div class="tk-fam-or">{M.famOr}</div>
      <form class="tk-fam-inline" id="fam-join-form" autocomplete="off">
        <input id="fam-join-in" type="text" placeholder={M.famJoinPh} autocapitalize="characters" spellcheck="false" />
        <button type="submit" class="tk-fam-sec" id="fam-join">{M.famJoin}</button>
      </form>
    </div>
    <div id="fam-on" hidden>
      <div class="tk-f"><label>{M.famCodeL}</label><code class="tk-fam-code" id="fam-code"></code></div>
      <div class="tk-fam-inline"><button type="button" class="tk-save" id="fam-copy">{M.famCopy}</button><button type="button" class="tk-save tk-fam-share" id="fam-share" hidden>{M.famShare}</button></div>
      <details class="tk-fam-edit tk-edit-only" id="fam-edit"><summary>{M.famEditH}</summary><p class="tk-hint">{M.famEditTx}</p><button type="button" class="tk-fam-sec" id="fam-edit-go">{M.famEditGo}</button></details>
      <div class="tk-f"><label>{M.famMembers}</label><ul class="tk-fam-members" id="fam-members"></ul></div>
      <div class="tk-fam-inline tk-fam-danger"><button type="button" id="fam-regen" class="tk-edit-only">{M.famRegen}</button><button type="button" id="fam-leave">{M.famLeave}</button></div>
    </div>
    <p class="tk-fam-warn">{M.famWarn}</p>
  </section>

  <div class="tk-sheet-bg" id="mv-bg" hidden></div>
  <section class="tk-sheet tk-fam tk-mv" id="mv-sheet" hidden aria-labelledby="mv-title">
    <div class="tk-sheet-h"><h3 id="mv-title">🔄 {M.mvTitle}</h3><button type="button" class="tk-x" id="mv-close" aria-label={M.close}>✕</button></div>
    <p class="tk-fam-intro">{M.mvIntro}</p>
    <div class="tk-mv-box" id="mv-send">
      <h4>{M.mvSendH}</h4>
      <p class="tk-hint" id="mv-q" hidden></p>
      <button type="button" class="tk-save" id="mv-start" hidden>{M.mvStart}</button>
      <div id="mv-out" hidden>
        <div class="tk-mv-row"><div class="tk-mv-qr" id="mv-qr" aria-hidden="true"></div><div class="tk-mv-cd"><code id="mv-code"></code><small id="mv-left"></small></div></div>
        <div class="tk-fam-inline"><button type="button" class="tk-save" id="mv-copy">{M.mvCopy}</button><button type="button" class="tk-save tk-fam-share" id="mv-share" hidden>{M.mvShare}</button></div>
        <a class="tk-save tk-mv-chrome" id="mv-chrome" hidden>{M.mvChrome}</a>
        <p class="tk-mv-how">{M.mvHow}</p>
      </div>
      <p class="tk-hint tk-mv-err" id="mv-err" hidden></p>
    </div>
    <div class="tk-mv-box" id="mv-recv">
      <h4>{M.mvRecvH}</h4>
      <form class="tk-fam-inline" id="mv-form" autocomplete="off">
        <input id="mv-in" type="text" placeholder={M.mvInPh} autocapitalize="characters" spellcheck="false" />
        <button type="submit" class="tk-fam-sec" id="mv-go">{M.mvGo}</button>
      </form>
      <p class="tk-mv-how">{M.mvRecvHint}</p>
    </div>
  </section>

  <div class="tk-toast" id="toast" hidden role="status" aria-live="polite">
    <div class="tk-toast-bar" id="toast-bar"></div>
    <span class="tk-toast-tx" id="toast-tx"></span>
    <span class="tk-toast-act" id="toast-act"></span>
  </div>
  <button type="button" class="tk-fab" id="fab" aria-label={M.fabAria}><span aria-hidden="true">🎤</span><b>{M.fab}</b></button>
</Base>

<script>
  import * as T from "../lib/tracker-core.js";
  import { babyForecast } from "../lib/tracker-forecast.js";
  import { STR, pageLang } from "../lib/tracker-i18n.js";
  import { createSync } from "../lib/tracker-sync.js";
  import { detectPlatform, externalOpenUrl, isStandalone, wasInstalled, canPrompt, promptInstall, appPushMode, appPushAction } from "../lib/app-install.js";
  import { createPush } from "../lib/push-client.js";
  import qrcode from "qrcode-generator";
  const LANG = pageLang(document.documentElement.lang);
  const L = STR[LANG];
  const $ = (id) => document.getElementById(id);
  const ga = (name, params) => { try { window.gtag && window.gtag("event", name, { ...params, lang: LANG }); } catch {} };

  // ---------- storage ----------
  function load() {
    try { const d = JSON.parse(localStorage.getItem(T.STORAGE_KEY) || "null"); return Array.isArray(d?.entries) ? d.entries.map(T.cleanEntry).filter(Boolean) : []; } catch { return []; }
  }
  let entries = load();
  let prefs = (() => { try { return JSON.parse(localStorage.getItem(T.STORAGE_KEY + "_prefs") || "{}"); } catch { return {}; } })();
  let lastSaved = entries;
  let Sync = null; // set below (family sharing)
  function persist() { try { localStorage.setItem(T.STORAGE_KEY, JSON.stringify({ v: 1, entries })); return true; } catch { toast(L.storageFull); return false; } }
  const viewOnly = () => !!(Sync && Sync.locked);
  function save() {
    if (viewOnly()) { entries = lastSaved; render(); toast(L.fam.viewOnlyToast, [], 2500); return; } // view-only: nothing is ever saved or sent
    const now = Date.now();
    const d = T.diffEntries(lastSaved, entries);
    if (d.upserts.length || d.deletes.length) {
      const prevIds = new Set(lastSaved.map((e) => e.id)), stamped = new Map();
      for (const e of d.upserts) {
        const x = { ...e, updatedAt: Math.max(now, (e.updatedAt || 0) + 1) };
        if (!prevIds.has(e.id) && !x.by && Sync && Sync.nick()) x.by = Sync.nick();
        if (!prevIds.has(e.id) && !x.dev && Sync) x.dev = Sync.dev;
        stamped.set(e.id, x);
      }
      entries = entries.map((e) => stamped.get(e.id) || e);
      if (Sync) Sync.recordLocal([...stamped.values()], d.deletes, now);
    }
    persist(); lastSaved = entries;
    render();
  }
  const savePrefs = () => { try { localStorage.setItem(T.STORAGE_KEY + "_prefs", JSON.stringify(prefs)); } catch {} };
  window.addEventListener("storage", (e) => { if (e.key === T.STORAGE_KEY) { entries = load(); lastSaved = entries; render(); } });

  // ---------- render ----------
  let viewDay = T.startOfDay(Date.now());
  const dayLabel = (ds) => { const d = new Date(ds), today = T.startOfDay(Date.now());
    if (ds === today) return L.today; if (ds === T.startOfDay(today - 12 * T.HOUR)) return L.yesterday;
    return L.dayShort(d); };
  const ICON = (e) => e.type === "feed" ? "🍼" : e.type === "sleep" ? "😴" : e.d === "poop" ? "💩" : e.d === "both" ? "💩💧" : "💧";
  const esc = (s) => String(s).replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]);

  let famOn = false;
  function render() {
    const now = Date.now();
    if (window.__mvHint) window.__mvHint();
    const li = T.lastInfo(entries, now);
    $("since-feed").querySelector("b").textContent = li.feed ? L.ago(li.feedAgo) : "-";
    $("since-sleep").querySelector("span").textContent = li.sleeping ? L.sleepingNow : L.awakeFor;
    $("since-sleep").querySelector("b").textContent = li.sleeping ? L.dur(li.sleepFor) : li.awakeFor != null ? L.dur(li.awakeFor) : "-";
    $("since-sleep").classList.toggle("on", li.sleeping);
    $("since-diaper").querySelector("b").textContent = li.diaper ? L.ago(li.diaperAgo) : "-";
    const qs = $("q-sleep");
    qs.classList.toggle("on", li.sleeping);
    qs.querySelector(".e").textContent = li.sleeping ? "🌤️" : "😴";
    qs.querySelector(".l").textContent = li.sleeping ? L.btnWoke : L.btnAsleep;

    const today = T.startOfDay(now);
    const s = T.daySummary(entries, today, now);
    $("sum-date").textContent = L.dateLong(new Date(now));
