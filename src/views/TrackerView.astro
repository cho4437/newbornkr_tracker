  // ---------- commit helpers ----------
  /** Apply parsed commands; returns { done: [[cmd, entry]], changes: [{id, prev}] for undo, note } (nothing saved yet). */
  function applyCmds(cmds) {
    let list = entries; const done = [], changes = []; let note = null;
    for (const c of cmds) { const r = T.applyCommand(list, c); if (r.entry) { list = r.entries; done.push([c, r.entry]); changes.push({ id: r.entry.id, prev: r.prev || null }); } else note = L.notes[r.code] || L.cantLog; }
